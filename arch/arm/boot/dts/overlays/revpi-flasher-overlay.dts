#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

/dts-v1/;
/plugin/;

/ {
	compatible = "brcm,bcm2712";

	fragment@0 {
		target-path = "/";
		__overlay__ {
			compatible = "kunbus,revpi-flasher", "brcm,bcm2712";

			leds {
				compatible = "gpio-leds";
				power_red {
					label = "power:1:fault";
					gpios = <&exp_gpio 0 GPIO_ACTIVE_HIGH>;
					linux,default-trigger = "power_red";
				};
				a1_red {
					label = "a1:red:status";
					gpios = <&exp_gpio 1 GPIO_ACTIVE_LOW>;
					linux,default-trigger = "a1_red";
				};
				a1_green {
					label = "a1:green:status";
					gpios = <&exp_gpio 2 GPIO_ACTIVE_LOW>;
					linux,default-trigger = "a1_green";
				};
				a1_blue {
					label = "a1:blue:status";
					gpios = <&exp_gpio 3 GPIO_ACTIVE_LOW>;
					linux,default-trigger = "a1_blue";
				};
				a2_red {
					label = "a2:red:status";
					gpios = <&exp_gpio 4 GPIO_ACTIVE_LOW>;
					linux,default-trigger = "a2_red";
				};
				a2_green {
					label = "a2:green:status";
					gpios = <&exp_gpio 5 GPIO_ACTIVE_LOW>;
					linux,default-trigger = "a2_green";
				};
				a2_blue {
					label = "a2:blue:status";
					gpios = <&exp_gpio 6 GPIO_ACTIVE_LOW>;
					linux,default-trigger = "a2_blue";
				};
			};

			/* Raspberry Pi display configuration taken from
			* vc4-kms-dsi-ili9881-7inch-overlay.dts. */
			touch_reg: touch_reg@1 {
				reg = <1>;
				compatible = "regulator-fixed";
				regulator-name = "touch_reg_1";
				gpio = <&display_mcu 1 GPIO_ACTIVE_HIGH>;
				startup-delay-us = <50000>;
				enable-active-high;
			};
		};
	};

	/* GPIOS/PINMUX */
	fragment@1 {
		target = <&gpio>;
		__overlay__ {
			gpio-line-names =
				"ID_SDA", // GPIO0
				"ID_SCL", // GPIO1
				"I2C1_SDA", // GPIO2
				"I2C1_SCL", // GPIO3
				"-", // GPIO4
				"-", // GPIO5
				"-", // GPIO6
				"-", // GPIO7
				"-", // GPIO8
				"-", // GPIO9
				"nDUT_INT", // GPIO10
				"-", // GPIO11
				"UART4_TX", // GPIO12
				"UART4_RX", // GPIO13
				"-", // GPIO14
				"-", // GPIO15
				"-", // GPIO16
				"ID_WP", // GPIO17
				"-", // GPIO18
				"-", // GPIO19
				"-", // GPIO20
				"-", // GPIO21
				"-", // GPIO22
				"RSVD_4", // GPIO23
				"RSVD_3", // GPIO24
				"-", // GPIO25
				"RSVD_1", // GPIO26
				"-", // GPIO27

				/*
				 * GPIO line names >= 28 are taken from
				 * arch/arm64/boot/dts/broadcom/bcm2712-rpi-cm5.dtsi
				 */
				"PCIE_PWR_EN", // GPIO28
				"FAN_TACH", // GPIO29
				"HOST_SDA", // GPIO30
				"HOST_SCL", // GPIO31
				"ETH_RST_N", // GPIO32
				"PCIE_DET_WAKE", // GPIO33

				"CD0_IO0_MICCLK", // GPIO34
				"CD0_IO0_MICDAT0", // GPIO35
				"RP1_PCIE_CLKREQ_N", // GPIO36
				"ETH_IRQ_N", // GPIO37
				"SDA0", // GPIO38
				"SCL0", // GPIO39
				"-", // GPIO40
				"-", // GPIO41
				"USB_VBUS_EN", // GPIO42
				"USB_OC_N", // GPIO43
				"RP1_STAT_LED", // GPIO44
				"FAN_PWM", // GPIO45
				"-", // GPIO46
				"2712_WAKE", // GPIO47
				"-", // GPIO48
				"-", // GPIO49
				"-", // GPIO50
				"-", // GPIO51
				"-", // GPIO52
				"-"; // GPIO53

			i2c1_pins: i2c1_pins {
				/* SDA, SCL */
				function = "i2c1";
				pins = "gpio2", "gpio3";
				bias-disable;
			};
			i2c1_irq_pins: i2c1_irq_pins {
				/* IRQ */
				function = "gpio";
				pins = "gpio10";
				bias-disable;
			};
			flasher_uart4_pins: flasher_uart4_pins {
				/* TX RX */
				function = "uart4";
				pins = "gpio12", "gpio13";
				bias-disable;
			};
		};
	};

	/* I2C1 */
	fragment@2 {
		target = <&i2c1>;
		__overlay__ {
			pinctrl-names = "default";
			pinctrl-0 = <&i2c1_pins>;
			clock-frequency = <400000>;
			status = "okay";

			exp_gpio: gpio@22 {
				/* 100kHz, 400kHz */
				compatible = "nxp,pcal6524";
				pinctrl-names = "default";
				pinctrl-0 = <&i2c1_irq_pins>;
				reg = <0x22>;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				interrupt-parent = <&gpio>;
				interrupts = <10 IRQ_TYPE_LEVEL_LOW>;
				status = "okay";
				gpio-line-names =
					"LEDS_PWRRED", // GPIO0 / P0_0
					"LEDS_A1RED", // GPIO1 / P0_1
					"LEDS_A1GRN", // GPIO2 / P0_2
					"LEDS_A1BLUE", // GPIO3 / P0_3
					"LEDS_A2RED", // GPIO4 / P0_4
					"LEDS_A2GRN", // GPIO5 / P0_5
					"LEDS_A2BLUE", // GPIO6 / P0_6
					"LEDS_PWRBLUE", // GPIO7 / P0_7
					"DUT4_RUN", // GPIO8 / P1_0
					"DUT3_RUN", // GPIO9 / P1_1
					"DUT2_RUN", // GPIO10 / P1_2
					"DUT7_RUN", // GPIO11 / P1_3
					"DUT8_RUN", // GPIO12 / P1_4
					"DUT7_RUN", // GPIO13 / P1_5
					"DUT6_RUN", // GPIO14 / P1_6
					"DUT5_RUN", // GPIO15 / P1_7
					"DUT4_DIAG", // GPIO16 / P2_0
					"DUT3_DIAG", // GPIO17 / P2_1
					"DUT2_DIAG", // GPIO18 / P2_2
					"DUT7_DIAG", // GPIO19 / P2_3
					"DUT8_DIAG", // GPIO20 / P2_4
					"DUT7_DIAG", // GPIO21 / P2_5
					"DUT6_DIAG", // GPIO22 / P2_6
					"DUT5_DIAG"; // GPIO23 / P2_7
			};

			/* Raspberry Pi display configuration taken from
			* vc4-kms-dsi-ili9881-7inch-overlay.dts. */
			display_mcu: display_mcu@45
			{
				compatible = "raspberrypi,v2-touchscreen-panel-regulator";
				reg = <0x45>;
				gpio-controller;
				#gpio-cells = <2>;
			};

			gt911: gt911@5d {
				compatible = "goodix,gt911";
				reg = <0x5d>;
				AVDD28-supply = <&touch_reg>;
				touchscreen-size-x = <720>;
				touchscreen-size-y = <1280>;
				touchscreen-x-mm = <90>;
				touchscreen-y-mm = <151>;
			};
		};
	};

	/* Raspberry Pi display configuration taken from
	* vc4-kms-dsi-ili9881-7inch-overlay.dts. */
	dsi_frag: fragment@3 {
		target = <&dsi1>;
		__overlay__  {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			port {
				dsi_out: endpoint {
					remote-endpoint = <&panel_in>;
				};
			};

			dsi_panel: dsi_panel@0 {
				reg = <0>;
				compatible = "raspberrypi,dsi-7inch";
				reset-gpio = <&display_mcu 0 GPIO_ACTIVE_LOW>;
				backlight = <&display_mcu>;
				rotation = <270>;

				port {
					panel_in: endpoint {
						remote-endpoint = <&dsi_out>;
					};
				};
			};
		};
	};

	fragment@4 {
		target = <&i2c0if>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@5 {
		target = <&i2c0mux>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@6 {
		target = <&uart4>;
		__overlay__ {
			pinctrl-names = "default";
			pinctrl-0 = <&flasher_uart4_pins>;
			status = "okay";
		};
	};

	/* Permanently disable HDMI1 */
	fragment@7 {
		target = <&hdmi1>;
		__overlay__ {
			/* make compatible unusable so it can't get probed */
			compatible = "disabled";
			status = "disabled";
		};
	};

	fragment@8 {
		target = <&ddc1>;
		__overlay__ {
			/* make compatible unusable so it can't get probed */
			compatible = "disabled";
			status = "disabled";
		};
	};

	fragment@9 {
		target = <&pixelvalve1>;
		__overlay__ {
			/* make compatible unusable so it can't get probed */
			compatible = "disabled";
			status = "disabled";
		};
	};
};
